# Example only; replace locally with your Supabase project values.
# Project URL: Supabase Dashboard > Connect dialog or Project Settings > API Keys.
SUPABASE_URL=https://your-project-ref.supabase.co
# Public publishable key (or legacy anon key) from Project Settings > API Keys.
SUPABASE_ANON_KEY=your-publishable-or-anon-key
# The API forwards each verified caller JWT so PostgREST RLS applies. Never use service_role here.
HOST=127.0.0.1
PORT=4000
